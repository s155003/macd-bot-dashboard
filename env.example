# Copy this file to .env and fill in your credentials.

# Alpaca paper trading credentials (get from https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Strategy parameters (optional — defaults shown)
BOT_SYMBOL=SPY
BOT_QTY=1
BOT_INTERVAL_SEC=14400
BOT_LOOKBACK_DAYS=100
